{
  "name": "microrhythms",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "cf dev",
    "build": "tsc --noEmit && cf build",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "test:audio": "playwright test --grep-invert '@extended|@large'",
    "test:audio:extended": "playwright test --grep @extended",
    "test:audio:large": "playwright test --grep @large",
    "test:audio:full": "playwright test",
    "preview": "vite preview",
    "deploy": "tsc --noEmit && cf deploy"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.12",
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "cf": "^0.15.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
